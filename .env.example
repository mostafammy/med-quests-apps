# ==============================================================================
# Med Quests Apps — Frontend Client Environment Configuration Template
# Copy this file to `.env` for local frontend configuration.
# ==============================================================================

# Application & API Origins
VITE_APP_URL="https://med-quests-apps.mostafa-yaser-developer.workers.dev"
VITE_CLOUDFLARE_EDGE_URL="https://med-quests-apps.mostafa-yaser-developer.workers.dev"

# Cloudflare Infrastructure IDs
VITE_D1_DATABASE_ID="0bb4ea27-4130-49ef-bc8d-3ed88a3d2fe8"
VITE_KV_NAMESPACE_ID="a5b932a09dba44e7860785ceeac5db06"

# ==============================================================================
# Production OAuth 2.0 Client Credentials
# ==============================================================================
# 1. Google Identity Services (GIS) Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins: http://localhost:5173, https://med-quests-apps.mostafa-yaser-developer.workers.dev
VITE_GOOGLE_CLIENT_ID=""

# 2. Sign in with Apple Services ID
# Obtain from Apple Developer Account > Certificates, Identifiers & Profiles > Services IDs
# e.g., "org.medquests.web"
VITE_APPLE_CLIENT_ID=""

# 3. Apple Sign-In Redirect URI
# Must match the Website URL configured in Apple Developer Portal for the Services ID
VITE_APPLE_REDIRECT_URI="http://localhost:5173"

# Environment Mode
VITE_ENVIRONMENT="development"

# ==============================================================================
# Optional: BYO Cloud AI Provider Keys (for AI Socratic Tutor Cloud Streaming)
# ==============================================================================
# Verified working Gemini models:
# - gemini-3.5-flash-lite: Fastest response, lowest latency (default)
# - gemini-2.5-flash: Standard clinical reasoning
# - gemini-3.8-flash: High reasoning & thinking capabilities
# (Avoid aliases like gemini-flash-latest to prevent 503 capacity errors)
VITE_GEMINI_API_KEY=""

# Verified working OpenRouter models:
# - nvidia/nemotron-3.5-lightning:free (Recommended free tier, 1M context)
# - recursive/flint-v1.0:free (Agentic MoE)
# - google/gemini-2.5-flash (Paid/BYOK via OpenRouter)
VITE_OPENROUTER_API_KEY=""
