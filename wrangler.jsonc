{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "med-quests-apps",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://med-quests-apps.mostafa-yaser-developer.workers.dev",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "QDD_MODE": "enforce",
    "QDD_THRESHOLDS_VERSION": "v1",
    "QDD_DAILY_BUDGET": "{\"embedding\":4000,\"rerank\":1500,\"llm\":150}"
  },
  "vectorize": [
    {
      "binding": "QDD_VECTORS",
      "index_name": "qdd-bge-small-en-v1"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "MED_QUESTS_DB",
      "database_name": "med_quests_db",
      "database_id": "0bb4ea27-4130-49ef-bc8d-3ed88a3d2fe8",
      "migrations_dir": "./src/worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MED_QUESTS_AUTH_KV",
      "id": "a5b932a09dba44e7860785ceeac5db06"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
